# PulseGate Environment Configuration
PROJECT_NAME="PulseGate API Gateway"
ENVIRONMENT=development
DEBUG=True

# =================================================================
# Database Configuration (MySQL & SQLite Supported)
# =================================================================
# OPTION 1: MySQL (Use this if you have MySQL installed)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pulsegate_db

# OPTION 2: SQLite (Uncomment if you want zero-setup local file database without MySQL)
# DATABASE_URL=sqlite:///./pulsegate.db

# =================================================================
# Rate Limiter Configuration
# =================================================================
# Pure in-memory Token Bucket by default (zero Redis required!)
RATE_LIMITER_BACKEND=memory

# =================================================================
# Security & Authentication
# =================================================================
JWT_SECRET=pulsegate_super_secret_jwt_key_2026_dse_sp
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Rate Limiting (Token Bucket: 20 requests per 60-second window)
DEFAULT_RATE_LIMIT=20
RATE_WINDOW_SECONDS=60

# Downstream URL Security Allowlist ('*' allows testing any real external/public API)
ALLOWED_TARGET_HOSTS=*

# =================================================================
# Machine Learning Anomaly Detection Settings
# =================================================================
MODEL_PATH=app/ml/model/isolation_forest.joblib
ANOMALY_CONTAMINATION=0.03
ANOMALY_WINDOW_SECONDS=60
